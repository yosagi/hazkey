<?xml version="1.0" encoding="utf-8"?>
<component>
    <name>org.freedesktop.IBus.Hazkey</name>
    <description>Hazkey Component</description>
    <exec>@HAZKEY_IBUS_ENGINE_PATH@ --ibus</exec>
    <version>@PROJECT_VERSION@</version>
    <author>Hazkey contributors</author>
    <license>MIT</license>
    <homepage>https://github.com/7ka-Hiira/hazkey</homepage>
    <textdomain>ibus-hazkey</textdomain>
    <engines>
        <engine>
            <name>hazkey</name>
            <language>ja</language>
            <license>MIT</license>
            <author>Hazkey contributors</author>
            <icon>@HAZKEY_ICON_PATH@</icon>
            <layout>default</layout>
            <longname>Hazkey</longname>
            <description>Japanese input method using AzooKeyKanaKanjiConverter</description>
            <rank>0</rank>
            <symbol>あ</symbol>
            <setup>@HAZKEY_SETTINGS_PATH@</setup>
        </engine>
    </engines>
</component>
